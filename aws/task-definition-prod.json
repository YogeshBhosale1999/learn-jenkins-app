{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "LearnJenkinsApp-TaskDefinition-Prod",
    "containerDefinitions": [
        {
            "name": "learnjenkinsapp",
            "image": "930271537876.dkr.ecr.us-east-1.amazonaws.com/myjenkinsapp:#APP_VERSION#",
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "3072",
    "cpu": "1024",
    "executionRoleArn": "arn:aws:iam::930271537876:role/ecsTaskExecutionRole"
}
